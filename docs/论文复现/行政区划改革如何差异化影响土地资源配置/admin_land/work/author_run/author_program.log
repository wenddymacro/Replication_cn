 16. merge m:1 市代码匹配 using gaitempcity
 17. drop treatnew
 18. gen treatnew=(_merge==3)
 19. drop postnew internew
 20. gen postnew=1 if newdate>=timelist&timelist!=.
 21. drop _merge
 22. save gaidid1_datacity,replace
 23. use gaidid1_datacity,clear
 24. gen internew=treatnew*postnew
 25. replace internew=0 if internew==.
 26. sort 市代码匹配
 27. global xlist_land "lnarea i.landuse zhaopaigua landlevel cunliang lndiscit
> y"
 28. global xlist_city "c.lnpergdp9#i.ym c.lnmidu9#i.ym c.fiscrev9#i.ym c.yicha
> n9#i.ym c.lnperdoctor9#i.ym"
 29. reghdfe lnaprice internew $xlist_land if landuse==1,cluster( 区代码匹配 ) 
> absorb( 区代码匹配 ym $xlist_city) 
 30. parmest,format (estimate min95 max95 %8.2f p %8.3f) saving("gaitemp1city.d
> ta", replace)
 31. use "gaitemp1city.dta", clear
 32. keep if parm=="internew"
 33. append using "gaisimulationscity.dta"
 34. save "gaisimulationscity.dta", replace
 35. }
