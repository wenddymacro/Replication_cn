> {fontface "宋体":处理组}"')  label(2 `"{fontface "宋体":控制组}"')  ring(0) pos
> (1) col(1))  xscale(range(2013.5 2023.5))  xtitle(`"{fontface "宋体":年份}"')  
> ytitle(`"{fontface "宋体":补贴总额（万元）}"')  xlabel(2014(1)2023)  graphregio
> n(color(white)) plotregion(color(white) margin(zero)) name(mygraph, replace)

