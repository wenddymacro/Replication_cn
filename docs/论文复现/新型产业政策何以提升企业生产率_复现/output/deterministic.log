. program define collect_result
  1. syntax, model(string)
  2. matrix bb=e(b)
  3. matrix vv=e(V)
  4. local terms : colnames bb
  5. local j=0
  6. foreach term of local terms {
  7. local ++j
  8. post coef ("`model'") ("`term'") (bb[1,`j']) (sqrt(vv[`j',`j'])) (e(N)) (e(r
> 2)) (e(r2_a)) (e(df_r))
  9. }
 10. estimates save "../output/`model'.ster", replace
 11. end

