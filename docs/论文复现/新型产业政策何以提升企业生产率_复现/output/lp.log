. // 事后动态效应：Y_(t+h)-Y_(t-1)，h=0,1,2,3
. forvalues h = 0/3 {
  2. if `h' == 0 {
  3. gen dy_p0 = TFP - L.TFP
  4. local clean "chainleader == 0"
  5. }
  6. else {
  7. gen dy_p`h' = F`h'.TFP - L.TFP
  8. local clean "F`h'.chainleader == 0"
