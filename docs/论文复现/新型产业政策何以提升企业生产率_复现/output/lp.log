. 
. matrix bb=lpdid_b

. matrix vv=lpdid_v

. postfile coef str40 term double b se using "../output/lp.dta", replace
(file ../output/lp.dta not found)

. local terms : colnames bb

. local j=0

. foreach term of local terms {
  2. local ++j
  3. post coef ("`term'") (bb[1,`j']) (sqrt(vv[`j',`j']))
  4. }

. postclose coef

. preserve

. use "../output/lp.dta", clear

. export delimited using "../output/lp.csv", replace
(file ../output/lp.csv not found)
file ../output/lp.csv saved

. restore

. 
. display "COMPLETE_lp"
COMPLETE_lp

