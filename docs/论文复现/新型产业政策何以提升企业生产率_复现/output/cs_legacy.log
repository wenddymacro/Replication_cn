. estimates restore cs_est
(results cs_est are active now)

. matrix cs_b = e(b)

. matrix cs_v = e(V)

. // long2下-1期为基期、不单独估计；若结果中无Tm1，则补0
. if missing(colnumb(cs_b, "Tm1")) {
. local cn : colnames cs_b
. matrix cs_b = cs_b, (0)
. matrix colnames cs_b = `cn' Tm1
. local k = colsof(cs_v)
. matrix cs_v = (cs_v, J(`k', 1, 0)) \ J(1, `k' + 1, 0)
. matrix colnames cs_v = `cn' Tm1
. matrix rownames cs_v = `cn' Tm1
. }

. 
. estimates save "../output/cs_legacy.ster", replace
(note: file ../output/cs_legacy.ster not found)
file ../output/cs_legacy.ster saved

. 
. matrix bb=cs_b

. matrix vv=cs_v

. postfile coef str40 term double b se using "../output/cs_legacy.dta", replace
(file ../output/cs_legacy.dta not found)

. local terms : colnames bb

. local j=0

. foreach term of local terms {
  2. local ++j
  3. post coef ("`term'") (bb[1,`j']) (sqrt(vv[`j',`j']))
  4. }

. postclose coef

. preserve

. use "../output/cs_legacy.dta", clear

. export delimited using "../output/cs_legacy.csv", replace
(file ../output/cs_legacy.csv not found)
file ../output/cs_legacy.csv saved

. restore

